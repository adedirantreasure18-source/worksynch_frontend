# Backend origin the frontend talks to.
# - Leave EMPTY for local dev (Vite proxies /api + /uploads to localhost:3000).
# - For production, set to your backend URL, e.g.:
#   VITE_API_URL=https://worksynch-backend.onrender.com
VITE_API_URL=""

# Optional: explicit WebSocket URL. Defaults to wss(s)://<VITE_API_URL host> or same-origin.
# VITE_WS_URL="ws://localhost:3000"

# Optional local-dev proxy target (defaults to http://localhost:3000)
# VITE_DEV_PROXY_TARGET="http://localhost:3000"

# Optional Google Cloud OAuth 2.0 Web Client ID for Google Workspace & Drive integration.
VITE_GOOGLE_CLIENT_ID=""

# Optional Google Maps browser key (or enter in Settings UI at runtime).
VITE_GOOGLE_MAPS_API_KEY=""
